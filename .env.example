# Copy to .env and fill in. Never commit .env.

# Credence ID Cloud SDK (from verify.credenceid.com → License Management)
CREDENCE_LICENSE_KEY=CS-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CREDENCE_PROFILE_ID=00000000-0000-0000-0000-000000000000
# Confirm in T12b: docs list /cloudsdk/playground, the React sample uses /cloudsdkdev
CREDENCE_BASE_URL=https://credenceid.com/cloudsdk/playground
# Must match the HTTPS domain registered in the portal (our Render URL)
CREDENCE_ORIGIN=https://your-service.onrender.com

# Credence ID Tap2iD (in-person) evaluation keys
TAP2ID_API_KEY=CSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAP2ID_SAMPLE_APP_KEY=CSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App
DATABASE_URL=sqlite:///./fieldverify.db
DEMO_AUDITOR_NAME="Demo Auditor"
RESULT_TTL_SECONDS=900
SERVE_FRONTEND=false

# Android reader (ADR-0006): shared secret the app sends as X-Device-Token. Any long random string.
ANDROID_DEVICE_TOKEN=change-me-to-a-long-random-string

# Demo provider = the identity in your own phone wallet (used only to seed one record locally)
DEMO_PROVIDER_FIRST=
DEMO_PROVIDER_LAST=
DEMO_PROVIDER_DOB=YYYY-MM-DD

# Demo reset (POST /api/demo/reset with header X-Demo-Reset-Token). Leave empty to disable the route entirely.
DEMO_RESET_TOKEN=
