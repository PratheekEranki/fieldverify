<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backend calls and the Tap2iD license check. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NFC engagement with the wallet phone. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- QR engagement: we scan the wallet's QR code with the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- The Tap2iD libraries merge in the BLUETOOTH_* permissions (data transfer is BLE).
         On Android 10-11, BLE scanning also needs location; Android 12+ uses BLUETOOTH_SCAN instead. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:name=".FieldVerifyApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FieldVerify">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.VerifyActivity"
            android:parentActivityName=".ui.MainActivity" />
        <activity
            android:name=".ui.ResultActivity"
            android:parentActivityName=".ui.MainActivity" />
    </application>
</manifest>
